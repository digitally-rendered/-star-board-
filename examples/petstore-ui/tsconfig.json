{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "tsBuildInfoFile": ".tsbuild/.tsbuildinfo",
    "emitDeclarationOnly": true,
    "types": ["node", "react"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.config.ts"],
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/runtime"
    },
    {
      "path": "../../packages/renderer-mui"
    }
  ]
}
