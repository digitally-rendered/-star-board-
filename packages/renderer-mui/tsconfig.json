{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "tsBuildInfoFile": ".tsbuild/.tsbuildinfo",
    "emitDeclarationOnly": true,
    "types": ["node", "react"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "*.config.ts"],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../runtime"
    },
    {
      "path": "../tokens"
    }
  ]
}
