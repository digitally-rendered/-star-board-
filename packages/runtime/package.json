  "description": "React runtime: RegistryProvider, ServicesProvider, typed client factory, data hooks on TanStack Query, capability gating, error presentation, i18n keys, agent affordance port.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
