    "test": "vitest run"
  },
  "dependencies": {
    "@star-board/core": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "openapi-fetch": "0.17.0"
  },
  "star-board": {
    "layer": "L2"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "28.1.0",
    "msw": "3.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
