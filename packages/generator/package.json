{
  "name": "@star-board/generator",
  "version": "0.0.1",
  "description": "FeatureModel to files: types, zod, typed client, action hooks, default screens, registry, routes, nav, i18n defaults; pure generate() and a drift check(); never writes overrides.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "star-board-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@star-board/core": "workspace:*",
    "@star-board/spec": "workspace:*",
    "openapi-typescript": "7.13.0"
  },
  "star-board": {
    "layer": "L4"
  }
}
