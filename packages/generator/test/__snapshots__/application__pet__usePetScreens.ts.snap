}

export function usePetDetailScreen(id: PetId, callbacks: PetDetailCallbacks): PetDetailScreenProps {
  const can = usePetCapabilities();
  const result = useEntity<Pet>('pet', id);
  const remove = usePetDelete();
  const actions: ActionProps[] = [];
  if (can.pet_update) actions.push({ operationId: 'pet_update', label: t('pet.action.pet_update.label'), disabled: false, onClick: () => { callbacks.onEdit(id); } });
  if (can.pet_delete) actions.push({ operationId: 'pet_delete', label: t('pet.action.pet_delete.label'), disabled: remove.isPending, onClick: () => { void remove.mutate({ id }).then(() => { callbacks.onDeleted(); }); } });
