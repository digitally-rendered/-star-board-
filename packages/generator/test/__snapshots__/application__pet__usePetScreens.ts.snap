/** The editable part of a pet record: the fields PetUpdate shares with the Document. */
export function toPetUpdate(entity: Pet): Partial<PetUpdate> {
  return { name: entity.name, status: entity.status, notes: entity.notes };
}

export function usePetEditScreen(id: PetId, callbacks: PetEditCallbacks): PetEditScreenProps {
  const can = usePetCapabilities();
  const result = useEntity<Pet>('pet', id);
  const update = usePetUpdate();
  const [edits, setEdits] = useState<Partial<PetUpdate>>({});
  const [errors, setErrors] = useState<Partial<Record<keyof PetUpdate, string>>>({});
  const values: Partial<PetUpdate> = { ...(result.data === undefined ? {} : toPetUpdate(result.data)), ...edits };
  return {
    status: statusOf(result, can.pet_update),
    error: messageOf(result.error),
    entity: result.data,
    values,
    errors,
    pending: update.isPending,
    submitError: messageOf(update.error),
    onChange: (field, value) => {
      setEdits((previous) => ({ ...previous, [field]: value }));
    },
    onSubmit: () => {
      const parsed = PetUpdateSchema.safeParse(values);
      if (!parsed.success) {
        setErrors(fieldErrors(parsed.error.issues));
        return;
      }
      setErrors({});
      void update.mutate({ id, body: parsed.data }).then(callbacks.onSaved);
    },
    onCancel: callbacks.onCancel,
  };
}

