    "version": "2026.10.0",
    "x-ownership-posture": "404"
  },
  "paths": {
    "/pet": {
      "get": {
        "operationId": "pet_list",
        "tags": ["pet"],
        "x-capabilities": ["pet:read"],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      },
      "post": {
        "operationId": "pet_create",
        "tags": ["pet"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PetCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created"
          },
          "422": {
            "description": "invalid"
          }
        }
      }
    },
    "/pet/{id}": {
      "get": {
        "operationId": "pet_get",
        "tags": ["pet"],
        "x-capabilities": ["pet:read"],
        "responses": {
          "200": {
            "description": "ok"
          },
          "404": {
            "description": "missing"
          }
        }
      },
      "patch": {
        "operationId": "pet_update",
        "tags": ["pet"],
        "x-capabilities": ["pet:write"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PetUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          },
          "412": {
            "description": "stale"
          }
        }
      },
      "delete": {
        "operationId": "pet_delete",
        "tags": ["pet"],
        "x-capabilities": ["pet:delete"],
        "responses": {
          "204": {
            "description": "gone"
          }
        }
      }
