    "/pet/{id}/_history": {
      "get": {
        "operationId": "pet_history",
        "tags": ["pet"],
        "x-capabilities": ["pet:read"],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/views/available-pets": {
      "get": {
        "operationId": "available_pets_query",
        "tags": ["pet"],
        "x-capabilities": ["pet:read"],
        "x-view": {
          "schema": "pet",
          "projection": ["name", "species", "status"],
          "filters": [
            {
              "field": "species",
              "op": "_eq"
            }
          ],
          "sort": [
            {
              "field": "name",
              "dir": "asc"
            }
          ],
          "limits": {
            "default": 25,
            "max": 100
          },
          "roles": ["customer", "staff"]
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": "object",
        "x-schema-version": "1.0.0",
        "x-owner-field": "created_by",
        "required": ["entity_id", "name", "species", "status"],
        "properties": {
          "entity_id": {
            "type": "string",
            "format": "uuid"
          },
          "record_version": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "x-ui-order": 1
          },
          "species": {
            "type": "string",
            "enum": ["dog", "cat", "bird"],
            "x-ui-order": 2,
            "x-ui-widget": "select"
          },
          "status": {
            "type": "string",
            "enum": ["available", "pending", "sold"],
            "x-ui-order": 3
          },
          "notes": {
            "type": "string",
            "x-ui-group": "details",
            "x-notes-reason": "Free text shown to staff only; never required so a sale is never blocked on paperwork."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "type": "string"
          }
        }
      },
      "PetCreate": {
        "type": "object",
        "additionalProperties": false,
        "x-schema-version": "1.0.0",
        "required": ["name", "species"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "species": {
            "type": "string",
            "enum": ["dog", "cat", "bird"]
          },
          "status": {
            "type": "string",
            "enum": ["available", "pending", "sold"],
            "default": "available"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "PetUpdate": {
        "type": "object",
        "additionalProperties": false,
        "x-schema-version": "1.0.0",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "status": {
            "type": "string",
            "enum": ["available", "pending", "sold"]
          },
          "notes": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
